# Environment variables for data-sourcing-agent (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_REGISTRATION_KEY=

# The model alias as the gateway knows it. Deliberately DeepSeek, not a Gemini
# alias. `deepseek-v4-flash` only supports prompted structured output - see
# agent/main.py and the handover memo §5.1 before changing it.
LITELLM_MODEL=deepseek-v4-flash

# The Validator's oracle credential. The agent cannot call a request valid or a
# cost known without it.
DATABENTO_API_KEY=

# The address the card advertises to the LiteLLM proxy. Must be reachable FROM
# the proxy's vantage on `ai_proxy`. `0.0.0.0` is a bind address and will
# register but never invoke; the container name is the working default.
A2A_CARD_URL=http://data-sourcing-agent:8700

# Where the gateway-assigned agent id is remembered. The container path is
# /state; the host side of the mount is set here. Point this at the deployed
# directory (e.g. /volumeUSB1/usbshare/docker/data-sourcing-agent/state) so the
# id survives a Watchtower recreate.
AGENT_STATE_HOST_DIR=./state
AGENT_STATE_DIR=/state
