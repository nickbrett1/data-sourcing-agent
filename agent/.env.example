# Environment for the data-sourcing-agent A2A agent.
# Generated by genproj. Do NOT commit real values; inject them from Doppler.
#
# The agent container reads these from its environment at startup.

# The LiteLLM gateway, used for the agent's outbound model calls (and its
# startup self-registration, when that was generated). It must be an address
# the agent's host can resolve - an IP or a working DNS name.
LITELLM_BASE_URL=http://litellm:4000

# A virtual key scoped to invoking this agent and calling the models it uses.
LITELLM_API_KEY=

# A key bound to a proxy_admin USER (not the master key, and not a key minted
# with user_role on /key/generate - that field is silently ignored). It is a
# control-plane secret: rotate it independently of the gateway.
LITELLM_REGISTRATION_KEY=

# Where the gateway id assigned to this agent is remembered between runs,
# so a listing filtered by the key's owner cannot make a registered agent
# look absent. Defaults to ~/.local/state/pydantic-agent/<agent-name>/ when
# unset. That default is in the image layer: it survives a restart of the
# same container but not a rebuild/recreate. Mount a writable host directory
# (docker-container.dataMounts with readOnly: false - dataMounts are
# read-only by default) and point this at it to keep the id across redeploys.
# An unwritable path is tolerated: registration still succeeds.
AGENT_STATE_DIR=

# The model alias as the gateway knows it. Deliberately DeepSeek, not a Gemini
# alias.
LITELLM_MODEL=deepseek-v4-flash

# The Validator's oracle credential: the Databento historical API key. Present =
# the agent can validate and price a request; absent = it cannot, by design.
DATABENTO_API_KEY=

# The address the card advertises to the LiteLLM proxy, when the container
# cannot infer a reachable one. Must be reachable FROM the proxy's host.
# `0.0.0.0` is a bind address, not a dial address: registering it looks green
# and every invocation fails. The container name is the working default.
A2A_CARD_URL=http://data-sourcing-agent:8700

# --- roost (fleet mission control) ------------------------------------------
# The hub this agent dials to appear in the fleet view. NO DEFAULT, on purpose:
# roost runs on a different Docker network from this container (which is on
# `ai_proxy`), so neither `nas` nor `roost` resolves from here and genproj cannot
# derive an address. With this unset, the roost client is not built at all and
# the agent serves exactly as before (fail-open). See agent/README.md for the
# candidate addresses and what has to be chosen at deploy time.
ROOST_HUB_URL=

# The agentId this agent claims in its `hello`. Blank derives it from the
# agent's name ("data-sourcing-agent"). If the hub enforces tokens
# (ROOST_AGENT_TOKENS), this MUST match the id the hub's map keys on.
ROOST_AGENT_ID=

# OPTIONAL escape hatch. `ROOST_ENABLED=false` keeps the URL set but never dials.
ROOST_ENABLED=true

# The NAME of the environment variable holding the bearer token for /agent/ws.
# A name, not a value: a hub with ROOST_AGENT_TOKENS unset accepts an anonymous
# dial and needs no token. The token itself is a secret - inject it from Doppler,
# never bake it into the image.
ROOST_TOKEN_ENV=ROOST_AGENT_TOKEN
ROOST_AGENT_TOKEN=
